[Unit]
Description=TradePulse AI Django backend (gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/tradepulse-truedata/backend
EnvironmentFile=/home/ubuntu/tradepulse-truedata/backend/.env
ExecStartPre=/home/ubuntu/tradepulse-truedata/backend/venv/bin/python manage.py migrate --no-input
# --workers must stay at 1 (see start.sh's Render config for the full rationale:
# in-process APScheduler + single-session broker login, both process-scoped).
# --worker-class gthread --threads 4: request concurrency via threads instead of
# processes, sharing the one process/scheduler/session.
# --timeout 300 (not gunicorn's 30s default, audit fix H17): the in-process
# APScheduler runs run_periodic_scanners every 15 min, walking hundreds of symbols
# one-by-one via REST in this same worker process — a short timeout lets gunicorn's
# arbiter SIGKILL the worker mid-scan. Render's start.sh already carries this fix;
# this Oracle unit had drifted from it.
ExecStart=/home/ubuntu/tradepulse-truedata/backend/venv/bin/gunicorn config.wsgi:application \
    --workers 1 \
    --worker-class gthread --threads 4 \
    --timeout 300 \
    --bind unix:/run/tradepulse-backend.sock \
    --access-logfile /home/ubuntu/tradepulse-truedata/backend/logs/gunicorn-access.log \
    --error-logfile /home/ubuntu/tradepulse-truedata/backend/logs/gunicorn-error.log
Restart=always
RestartSec=5

# gunicorn writes the socket before nginx (running as www-data) needs to read it
UMask=0007

[Install]
WantedBy=multi-user.target
