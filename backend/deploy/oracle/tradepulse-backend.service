[Unit]
Description=TradePulse AI Django backend (gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/tradepulse-ai/backend
EnvironmentFile=/home/ubuntu/tradepulse-ai/backend/.env
ExecStartPre=/home/ubuntu/tradepulse-ai/backend/venv/bin/python manage.py migrate --no-input
ExecStart=/home/ubuntu/tradepulse-ai/backend/venv/bin/gunicorn config.wsgi:application \
    --workers 1 \
    --bind unix:/run/tradepulse-backend.sock \
    --access-logfile /home/ubuntu/tradepulse-ai/backend/logs/gunicorn-access.log \
    --error-logfile /home/ubuntu/tradepulse-ai/backend/logs/gunicorn-error.log
Restart=always
RestartSec=5

# gunicorn writes the socket before nginx (running as www-data) needs to read it
UMask=0007

[Install]
WantedBy=multi-user.target
